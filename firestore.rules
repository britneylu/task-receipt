rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // lets signed-in users access only their own completed history
    match /users/{userId}/history/{taskId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // denies access to every document path not allowed above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
